# ---- Boliviq environment template ----
# Copy to .env.local and fill in real values. NEVER commit the filled file.

# Client/public vars (safe to expose, must start with VITE_):
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_MODE=sandbox            # sandbox | live
VITE_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# Optional legacy alias for the publishable key:
# VITE_PAYMENTS_CLIENT_TOKEN=pk_test_...

# Server-only vars (NEVER prefix these with VITE_):
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Preferred direct Stripe secrets (independent of Lovable):
STRIPE_SECRET_KEY_TEST=sk_test_...
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET_TEST=whsec_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Optional legacy aliases (still accepted):
# STRIPE_SANDBOX_API_KEY=sk_test_...
# STRIPE_LIVE_API_KEY=sk_live_...
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_...
# PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_...
# LOVABLE_API_KEY=                      # only needed for the Lovable Stripe connector fallback
